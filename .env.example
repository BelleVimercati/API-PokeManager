# Aplicação
PORT=3333
NODE_ENV=development

# Banco de Dados PostgreSQL
POSTGRES_USER=manager
POSTGRES_PASSWORD=password
POSTGRES_DB=manager_db
POSTGRES_PORT=5432
# Usada pelo Prisma ao rodar fora do Docker (no Docker, o docker-compose define a sua)
DATABASE_URL="postgresql://manager:password@localhost:5432/manager_db?schema=public"

# pgAdmin
PGADMIN_EMAIL=admin@manager.com
PGADMIN_PASSWORD=adminpassword
PGADMIN_PORT=8080

# Integração externa (false = usa dados em memória, sem internet)
USE_EXTERNAL_API=true