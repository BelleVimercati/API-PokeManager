generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // O projeto compila para CommonJS (sem "type": "module" no package.json)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pokemon {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(100)
  type           String  @db.VarChar(50)
  level          Int     @default(1)
  spriteUrl      String? @map("sprite_url") @db.VarChar(255)
  baseExperience Int?    @map("base_experience")
  height         Int?
  weight         Int?

  @@map("pokemons")
}

model Trainer {
  id        Int     @id @default(autoincrement())
  name      String  @map("nome") @db.VarChar(100)
  email     String? @unique @db.VarChar(150)
  specialty String? @map("especialidade") @db.VarChar(100)

  @@map("trainers")
}
