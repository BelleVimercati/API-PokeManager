generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // O projeto compila para CommonJS (sem "type": "module" no package.json)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cada linha é um Pokémon capturado por um treinador (o time).
// Os dados vêm da PokéAPI no momento da captura.
model Pokemon {
  id             String   @id @default(uuid()) @db.Uuid
  pokedexId      Int      @map("pokedex_id")
  name           String   @db.VarChar(100)
  types          String[]
  spriteUrl      String?  @map("sprite_url") @db.VarChar(255)
  level          Int      @default(1)
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int      @map("special_attack")
  specialDefense Int      @map("special_defense")
  speed          Int
  capturedAt     DateTime @default(now()) @map("captured_at")

  trainerId Int     @map("trainer_id")
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("pokemons")
}

model Trainer {
  id        Int     @id @default(autoincrement())
  name      String  @map("nome") @db.VarChar(100)
  email     String? @unique @db.VarChar(150)
  specialty String? @map("especialidade") @db.VarChar(100)
  pokemons Pokemon[]

  @@map("trainers")
}
