{
  "openapi": "3.0.3",
  "info": {
    "title": "PokéManager API",
    "description": "API REST para gerenciamento do catálogo local de Pokémons.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Operações de cadastro do catálogo local de Pokémons"
    },
    {
      "name": "Trainers",
      "description": "Operações de cadastro de Treinadores"
    }
  ],
  "paths": {
    "/pokemons": {
      "get": {
        "tags": ["Pokemons"],
        "summary": "Lista os Pokémons do catálogo local",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filtra os Pokémons pelo tipo (ex: fire, water)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Pokemon" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Pokemons"],
        "summary": "Cadastra um novo Pokémon no catálogo local",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PokemonInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/PokemonInput" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pokemons/{id}": {
      "get": {
        "tags": ["Pokemons"],
        "summary": "Busca um Pokémon pelo id",
        "parameters": [{ "$ref": "#/components/parameters/PokemonId" }],
        "responses": {
          "200": {
            "description": "Pokémon encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Pokemon" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Pokemons"],
        "summary": "Atualiza os dados de um Pokémon do catálogo local",
        "parameters": [{ "$ref": "#/components/parameters/PokemonId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PokemonUpdateInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/PokemonInput" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Pokemons"],
        "summary": "Remove um Pokémon do catálogo local",
        "parameters": [{ "$ref": "#/components/parameters/PokemonId" }],
        "responses": {
          "200": {
            "description": "Pokémon removido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pokemons/{id}/level": {
      "patch": {
        "tags": ["Pokemons"],
        "summary": "Atualiza o nível de um Pokémon",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "level": { "type": "integer", "example": 25 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Nível atualizado" },
          "400": { "description": "Nível inválido" },
          "404": { "description": "Pokémon não encontrado" }
        }
      }
    },
    "/trainers": {
      "get": {
        "tags": ["Trainers"],
        "summary": "Lista os Treinadores",
        "responses": {
          "200": {
            "description": "Lista de Treinadores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Trainer" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Trainers"],
        "summary": "Cadastra um novo Treinador",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TrainerInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Treinador criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Trainer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/trainers/{id}": {
      "get": {
        "tags": ["Trainers"],
        "summary": "Busca um Treinador pelo id",
        "parameters": [{ "$ref": "#/components/parameters/TrainerId" }],
        "responses": {
          "200": {
            "description": "Treinador encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Trainer" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Trainers"],
        "summary": "Atualiza os dados de um Treinador",
        "parameters": [{ "$ref": "#/components/parameters/TrainerId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TrainerUpdateInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Treinador atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Trainer" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PokemonId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Id do Pokémon"
      },
      "TrainerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" },
        "description": "Id do Treinador"
      }
    },
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "PokemonInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["name", "type"]
      },
      "PokemonUpdateInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Ash Ketchum" },
          "email": { "type": "string", "example": "ash@pokemon.com" },
          "specialty": { "type": "string", "example": "Elétrico" }
        }
      },
      "TrainerInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Ash Ketchum" },
          "email": { "type": "string", "example": "ash@pokemon.com" },
          "specialty": { "type": "string", "example": "Elétrico" }
        },
        "required": ["name"]
      },
      "TrainerUpdateInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "specialty": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "statusCode": { "type": "integer" },
          "message": { "type": "string" }
        }
      }
    }
  }
}

