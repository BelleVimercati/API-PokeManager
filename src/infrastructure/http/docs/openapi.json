{
  "openapi": "3.0.3",
  "info": {
    "title": "PokéManager API",
    "description": "API REST para treinadores Pokémon: consulta a Pokédex direto na PokéAPI oficial e gerencia o time (até 6 Pokémons) de cada treinador.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Pokédex",
      "description": "Consulta direta à PokéAPI oficial (nada é salvo)"
    },
    {
      "name": "Trainers",
      "description": "Cadastro de Treinadores, capturas e time"
    }
  ],
  "paths": {
    "/pokedex/search": {
      "get": {
        "tags": ["Pokédex"],
        "summary": "Busca um Pokémon direto na PokéAPI",
        "description": "Consulta a PokéAPI oficial pelo nome e devolve o DTO formatado. Nada é salvo no banco.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Nome do Pokémon (sem diferenciar maiúsculas)",
            "example": "pikachu"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado na PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PokedexEntry"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro name ausente ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado na PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível ou fora do tempo limite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trainers": {
      "get": {
        "tags": ["Trainers"],
        "summary": "Lista os Treinadores",
        "responses": {
          "200": {
            "description": "Lista de Treinadores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trainer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Trainers"],
        "summary": "Cadastra um novo Treinador",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainerInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Treinador criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{id}": {
      "get": {
        "tags": ["Trainers"],
        "summary": "Busca um Treinador pelo id",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrainerId"
          }
        ],
        "responses": {
          "200": {
            "description": "Treinador encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Trainers"],
        "summary": "Atualiza os dados de um Treinador",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrainerId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainerUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Treinador atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um Treinador cadastrado com este e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainerId}/captures": {
      "post": {
        "tags": ["Trainers"],
        "summary": "Captura um Pokémon para o time do Treinador",
        "description": "Recebe o nome do Pokémon, consulta a PokéAPI oficial (imagem, atributos base e tipos), valida que o Treinador tem menos de 6 Pokémons no time e salva a captura associada a ele.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrainerIdRoute"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pokémon capturado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado ou Pokémon inexistente na PokéAPI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "O Treinador já possui 6 Pokémons no time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PokéAPI indisponível ou fora do tempo limite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainerId}/team": {
      "get": {
        "tags": ["Trainers"],
        "summary": "Lista o time atual do Treinador",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrainerIdRoute"
          }
        ],
        "responses": {
          "200": {
            "description": "Time do Treinador",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "$ref": "#/components/schemas/Pokemon"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Id inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trainers/{trainerId}/team/{pokemonId}": {
      "delete": {
        "tags": ["Trainers"],
        "summary": "Solta um Pokémon do time do Treinador",
        "description": "Remove o Pokémon do time, liberando uma vaga para nova captura. Um Treinador só pode soltar os próprios Pokémons.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TrainerIdRoute"
          },
          {
            "name": "pokemonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Id do Pokémon capturado (veja GET /trainers/{trainerId}/team)"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon solto com sucesso"
          },
          "400": {
            "description": "Id do Treinador ou do Pokémon inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado ou Pokémon não está no time deste Treinador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TrainerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Id do Treinador"
      },
      "TrainerIdRoute": {
        "name": "trainerId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Id do Treinador"
      }
    },
    "schemas": {
      "PokedexEntry": {
        "type": "object",
        "properties": {
          "pokedexId": {
            "type": "integer",
            "description": "Número na Pokédex nacional",
            "example": 25
          },
          "name": {
            "type": "string",
            "example": "pikachu"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["electric"]
          },
          "spriteUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Imagem oficial (official-artwork) da PokéAPI",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "baseExperience": {
            "type": "integer",
            "nullable": true,
            "example": 112
          },
          "height": {
            "type": "integer",
            "description": "Altura em decímetros",
            "example": 4
          },
          "weight": {
            "type": "integer",
            "description": "Peso em hectogramas",
            "example": 60
          },
          "stats": {
            "$ref": "#/components/schemas/PokemonStats"
          }
        }
      },
      "Pokemon": {
        "type": "object",
        "description": "Pokémon capturado, salvo no time de um Treinador",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f2b8c1e-7a4d-4c2e-9b1a-2d5e6f7a8b9c"
          },
          "pokedexId": {
            "type": "integer",
            "example": 25
          },
          "name": {
            "type": "string",
            "example": "pikachu"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["electric"]
          },
          "spriteUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Imagem oficial (official-artwork) da PokéAPI",
            "example": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
          },
          "level": {
            "type": "integer",
            "example": 1
          },
          "stats": {
            "$ref": "#/components/schemas/PokemonStats"
          },
          "trainerId": {
            "type": "integer",
            "example": 1
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-13T20:00:00.000Z"
          }
        }
      },
      "PokemonStats": {
        "type": "object",
        "description": "Atributos base (stats) oficiais da PokéAPI",
        "properties": {
          "hp": {
            "type": "integer",
            "example": 35
          },
          "attack": {
            "type": "integer",
            "example": 55
          },
          "defense": {
            "type": "integer",
            "example": 40
          },
          "specialAttack": {
            "type": "integer",
            "example": 50
          },
          "specialDefense": {
            "type": "integer",
            "example": 50
          },
          "speed": {
            "type": "integer",
            "example": 90
          }
        }
      },
      "CaptureInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nome do Pokémon na PokéAPI",
            "example": "pikachu"
          }
        },
        "required": ["name"]
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@pokemon.com"
          },
          "specialty": {
            "type": "string",
            "example": "Elétrico"
          }
        }
      },
      "TrainerInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "example": "ash@pokemon.com"
          },
          "specialty": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Elétrico"
          }
        },
        "required": ["name"]
      },
      "TrainerUpdateInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "specialty": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "description": "Presente apenas em erros de validação",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
